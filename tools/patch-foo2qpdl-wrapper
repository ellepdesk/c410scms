"""Derive foo2qpdl-c410scms-wrapper from foo2zjs' foo2qpdl-wrapper (GPL-2.0-or-later, Rick Richardson).

Adds colour mode -Cscms: gs renders RGB at 600 dpi, c410scms-filter converts and screens it,
foo2qpdl -z3 encodes it. Usage: patch-foo2qpdl-wrapper /usr/bin/foo2qpdl-wrapper out-file
"""
import sys

src, dst = sys.argv[1], sys.argv[2]
s = open(src).read()


def replace_once(old, new):
    global s
    if s.count(old) != 1:
        raise SystemExit(f"anchor not found exactly once: {old[:60]!r}")
    s = s.replace(old, new)


replace_once("""case "$COLORMODE" in
0|"")
    # Monochrome
    ;;
""", """case "$COLORMODE" in
0|"")
    # Monochrome
    ;;
scms)
    # Samsung SCMS colour tables and 2-bit screens via c410scms-filter
    GAMMAFILE=
    ;;
""")

replace_once("""foo2zjs-pstops $PSTOPS_OPTS | \\
$PREFILTER \\
| ($GS $PAPERSIZE -g$DIM -r$RES $GSDEV $GSOPTS \\""", """SCMS_DATA=${SCMS_DATA:-$PREFIX/share/foo2qpdl/c410scms.dat}
if [ "$COLORMODE" = scms -a "$COLOR" != "" -a "$RES" = 1200x600 ]; then
    XHALF=`expr $XDIM / 2`
    SDIM=${XHALF}x$YDIM
    DIM=`expr $XHALF \\* 2`x$YDIM
    # foo2qpdl -z3 labels every band 128 rows high but encodes the last one with only the rows
    # left, and the printer fills the rest with garbage (a black bar at the bottom right of the
    # CUPS test page). Extend the page into the bottom clip to a band boundary and print the
    # extension blank; if the clip is too small for that, clip to the band boundary instead.
    ULY=`echo "$CLIP_UL" | sed -n 's/.*x//p'`
    LRX=`echo "$CLIP_LR" | sed -n 's/^-l *//; s/x.*//p'`
    LRY=`echo "$CLIP_LR" | sed -n 's/.*x//p'`
    REM=`expr \\( $YDIM - ${ULY:-0} - ${LRY:-0} \\) % 128`
    BLANK=
    if [ $REM -ne 0 ]; then
	PAD=`expr 128 - $REM`
	if [ ${LRY:-0} -ge $PAD ]; then
	    BLANK="-b `expr $YDIM - ${LRY:-0}`"
	    LRY=`expr ${LRY:-0} - $PAD`
	else
	    LRY=`expr ${LRY:-0} + $REM`
	fi
	CLIP_LR="-l ${LRX:-0}x$LRY"
    fi
    foo2zjs-pstops $PSTOPS_OPTS | \\
    $PREFILTER \\
    | ($GS $PAPERSIZE -g$SDIM -r600x600 -sDEVICE=ppmraw $GSOPTS \\
	-sOutputFile="|cat 1>&3" -_ >/dev/null) 3>&1 \\
    | c410scms-filter $BLANK "$SCMS_DATA" \\
    | foo2qpdl -r$RES -g$DIM -p$PAPER -m$MEDIA -n$COPIES -d$DUPLEX -s$SOURCE \\
	    -z$MODEL $COLOR $CLIP_UL $CLIP_LR $CLIP_LOG $SAVETONER \\
	    -a$CA_B,$CA_C,$CA_S,$CA_CR,$CA_MG,$CA_YB \\
	    -J "$LPJOB" -U "$USER" -D$DEBUG
    exit
fi

foo2zjs-pstops $PSTOPS_OPTS | \\
$PREFILTER \\
| ($GS $PAPERSIZE -g$DIM -r$RES $GSDEV $GSOPTS \\""")

open(dst, "w").write(s)
print("wrote", dst)
